// === YouTube Bulk Unsubscribe Script ===
// Run this in browser console at https://www.youtube.com/feed/channels

(async () => {
  const delay = ms => new Promise(res => setTimeout(res, ms));

  // Get all "Subscribed" buttons
  let buttons = Array.from(document.querySelectorAll('ytd-subscribe-button-renderer yt-button-shape button'))
    .filter(btn => btn.textContent.trim().toLowerCase().includes('subscribed'));

  console.log(`Found ${buttons.length} subscribed channels.`);

  for (let i = 0; i < buttons.length; i++) {
    const btn = buttons[i];
    console.log(`Unsubscribing from channel ${i + 1}/${buttons.length}...`);

    btn.click(); // Open the unsubscribe confirmation dialog
    await delay(1000);

    // Confirm unsubscribe
    const confirmBtn = document.querySelector('tp-yt-paper-button#confirm-button');
    if (confirmBtn) {
      confirmBtn.click();
      console.log('Unsubscribed successfully.');
    } else {
      console.warn('Confirm button not found, skipping...');
    }

    // Wait between each unsubscribe (adjust delay as needed)
    await delay(2000);
  }

  console.log('✅ Finished unsubscribing from all visible channels.');
})();
