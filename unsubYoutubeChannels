/**
 * YouTube Mass Unsubscribe Script
 * * This script finds all 'Subscribed' buttons, clicks them, 
 * and then confirms the 'Unsubscribe' popup.
 */

const unsubscribeAll = async () => {
  // Find all subscription buttons on the page
  const buttons = document.querySelectorAll('button[aria-label^="Unsubscribe from"]');
  
  console.log(`Found ${buttons.length} channels to unsubscribe from.`);

  for (let i = 0; i < buttons.length; i++) {
    // Click the initial 'Subscribed' button
    buttons[i].click();

    // Wait a moment for the confirmation dialog to appear
    await new Promise(resolve => setTimeout(resolve, 500));

    // Find the 'Unsubscribe' button in the popup and click it
    const confirmButton = document.querySelector('yt-button-renderer#confirm-button button');
    if (confirmButton) {
      confirmButton.click();
      console.log(`Unsubscribed from channel #${i + 1}`);
    }

    // Wait a bit before the next one to avoid being flagged as a bot
    await new Promise(resolve => setTimeout(resolve, 1000));
  }

  console.log("Process complete! If there are more, scroll down and run again.");
};

unsubscribeAll();
