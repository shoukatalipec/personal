/**
 * Facebook Mass Unfriend Script (Consolidated Version 2026)
 * Built based on provided HTML: More Button -> Unfriend Item -> Confirm Dialog
 */

const startUnfriendCleanUp = async () => {
  console.log("%c Starting automated clean-up... ", "background: #222; color: #bada55; font-size: 15px;");

  while (true) {
    // 1. Find the "More" (three dots) buttons in the list you provided
    const moreButtons = Array.from(document.querySelectorAll('div[aria-label="More"][role="button"]'));

    if (moreButtons.length === 0) {
      console.log("No more buttons found. Scrolling to find more friends...");
      window.scrollBy(0, 1000);
      await new Promise(r => setTimeout(r, 2500));
      
      // Stop if no new buttons appear after scrolling
      if (document.querySelectorAll('div[aria-label="More"][role="button"]').length === 0) {
        console.log("Reached the end of the friends list.");
        break;
      }
      continue;
    }

    for (const btn of moreButtons) {
      // Bring the friend card into view
      btn.scrollIntoView({ behavior: 'smooth', block: 'center' });
      
      // Open the "More" menu
      btn.click(); 
      await new Promise(r => setTimeout(r, 1200));

      // 2. Find "Unfriend" in the menu role="menuitem"
      const menuItems = Array.from(document.querySelectorAll('div[role="menuitem"]'));
      const unfriendAction = menuItems.find(item => item.innerText.includes("Unfriend"));

      if (unfriendAction) {
        unfriendAction.click();
        console.log("Unfriend clicked. Waiting for confirmation dialog...");
        
        // Wait for the aria-modal="true" dialog to appear
        await new Promise(r => setTimeout(r, 1500));

        // 3. Click the "Confirm" button specifically (aria-label="Confirm")
        const confirmBtn = document.querySelector('div[role="dialog"] div[aria-label="Confirm"][role="button"]');
        
        if (confirmBtn) {
          confirmBtn.click();
          console.log("✅ Successfully Unfriended.");
        } else {
          // Fallback: If aria-label fails, find by text "Confirm"
          const fallbackBtn = Array.from(document.querySelectorAll('div[role="dialog"] div[role="button"]'))
            .find(b => b.innerText === "Confirm");
          if (fallbackBtn) {
            fallbackBtn.click();
            console.log("✅ Unfriended via text fallback.");
          }
        }
      } else {
        // If unfriend wasn't found, close the menu by clicking the dots again
        btn.click();
      }

      // 4. Randomized Safety Wait (6 to 10 seconds)
      // This mimics human speed to avoid your account being flagged.
      const waitTime = Math.floor(Math.random() * 4000) + 6000;
      console.log(`Waiting ${waitTime / 1000}s for safety...`);
      await new Promise(r => setTimeout(r, waitTime));
    }
  }

  console.log("Process complete!");
};

startUnfriendCleanUp();
