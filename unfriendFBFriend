/**
 * Advanced Script to Unfriend everyone with Confirmation Handling
 */
const unfriendAllWithConfirm = async () => {
    // ADJUST THESE DELAYS IF YOUR INTERNET IS SLOW
    const WAIT_FOR_MENU = 1000;    // Time to wait for the Unfriend menu to pop up
    const WAIT_FOR_MODAL = 1200;   // Time to wait for the Confirm box to pop up
    const NEXT_FRIEND_DELAY = 2500; // Time to wait before moving to the next person

    while (true) {
        // Find all "Three Dots" buttons
        let moreButtons = document.querySelectorAll('div[aria-label^="More options for"]');
        
        if (moreButtons.length === 0) {
            console.log("No visible friends. Scrolling...");
            window.scrollTo(0, document.body.scrollHeight);
            await new Promise(r => setTimeout(r, 3000));
            
            moreButtons = document.querySelectorAll('div[aria-label^="More options for"]');
            if (moreButtons.length === 0) {
                console.log("Finished! No more friends found.");
                break;
            }
        }

        for (let btn of moreButtons) {
            try {
                // 1. Click the "Three Dots" menu
                btn.scrollIntoView({ block: "center" }); // Ensure button is visible
                btn.click();
                await new Promise(r => setTimeout(r, WAIT_FOR_MENU));

                // 2. Click "Unfriend" in the menu
                const menuItems = document.querySelectorAll('div[role="menuitem"]');
                let unfriendBtn = Array.from(menuItems).find(el => el.innerText.includes("Unfriend"));

                if (unfriendBtn) {
                    unfriendBtn.click();
                    console.log("Clicked Unfriend... waiting for confirmation box.");
                    
                    // 3. Wait for the "Confirm" pop-up to appear
                    await new Promise(r => setTimeout(r, WAIT_FOR_MODAL));
                    
                    // Target the specific Confirm button from your HTML
                    const confirmBtn = document.querySelector('div[aria-label="Confirm"]');
                    
                    if (confirmBtn) {
                        confirmBtn.click();
                        console.log("Confirmed Unfriend.");
                    } else {
                        console.log("Confirm button not found, moving on.");
                    }
                }

                // 4. Wait before doing the next person
                await new Promise(r => setTimeout(r, NEXT_FRIEND_DELAY));
                
            } catch (err) {
                console.error("Error processing a friend, skipping...", err);
            }
        }
    }
};

unfriendAllWithConfirm();
