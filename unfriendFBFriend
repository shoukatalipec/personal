/**
 * WARNING: High-speed script. 
 * Use at your own risk of account restriction.
 */
const hyperUnfriend = async () => {
    // Delays set to roughly 100ms - 300ms
    const MENU_DELAY = 150; 
    const MODAL_DELAY = 250;
    const NEXT_DELAY = 100; 

    while (true) {
        let dots = document.querySelectorAll('div[aria-label^="More options for"]');

        if (dots.length === 0) {
            window.scrollTo(0, document.body.scrollHeight);
            await new Promise(r => setTimeout(r, 1000)); // Wait for scroll load
            dots = document.querySelectorAll('div[aria-label^="More options for"]');
            if (dots.length === 0) break;
        }

        for (let btn of dots) {
            try {
                // Step 1: Open Menu
                btn.click();
                
                // Step 2: Immediate check for Unfriend button
                await new Promise(r => setTimeout(r, MENU_DELAY));
                const unfriend = Array.from(document.querySelectorAll('div[role="menuitem"]'))
                                     .find(el => el.innerText.includes("Unfriend"));

                if (unfriend) {
                    unfriend.click();
                    
                    // Step 3: Immediate check for Confirm
                    await new Promise(r => setTimeout(r, MODAL_DELAY));
                    const confirm = document.querySelector('div[aria-label="Confirm"]');
                    
                    if (confirm) {
                        confirm.click();
                        console.log("⚡ Fast Unfriend Success");
                    }
                }

                // Small breather to let the DOM update
                await new Promise(r => setTimeout(r, NEXT_DELAY));
                
            } catch (e) {
                // If it fails, hit Escape to clear the screen and keep going
                window.dispatchEvent(new KeyboardEvent('keydown', { key: 'Escape' }));
            }
        }
    }
};

hyperUnfriend();
